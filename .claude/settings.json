{
  "permissions": {
    "allow": [
      "Bash(hugo:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git submodule status:*)"
